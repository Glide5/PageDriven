# Set these in Vercel → Project → Settings → Environment Variables (Production + Preview).
# Do not commit real values.

# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives every form submission
FORM_TO_EMAIL=riz@gopagedriven.com

# Sender address. Must be on a domain verified in Resend (see DEPLOY.md, step 2).
# Until the domain is verified, leave this unset to use Resend's test sender.
FORM_FROM_EMAIL=PageDriven <forms@gopagedriven.com>
